TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_DEFAULT_MODEL is also supported and takes precedence over TYPESAFE_MODEL.
# For an installed copy, set JEV_9000_ENV_FILE to an absolute .env path in the host environment.
# Logging is enabled by default. Set false to stop new consultation records; restart the host.
# JEV_9000_LOGGING=false
# Optional local records directory (default: ~/.jev-9000/logs).
# JEV_9000_LOG_DIR=C:/path/to/local/jev-logs
